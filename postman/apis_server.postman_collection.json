{
  "info": {
    "name": "apis_server - API de vistas Oracle",
    "description": "Colección de prueba de la API local.\n\n1. Importar también el environment `postman/local.postman_environment.json` y seleccionarlo.\n2. Levantar la API con `run_local.bat`.\n\nEl login es automático: cada request pide un token si no hay uno vigente.\n\nSin Oracle disponible, los listados y detalles responden 500 genérico: los tests lo aceptan y verifican que no se filtre información interna. Rate limit por defecto: 60 requests/minuto por IP y 10 logins/minuto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Login automático: obtiene un token si no hay uno o si vence en menos de 30 s.",
          "// No corre en el propio login ni en los requests marcados \"No Auth\".",
          "const isLogin = pm.request.url.getPath().endsWith(\"/v1/auth/token\");",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === \"noauth\";",
          "const expires = Number(pm.environment.get(\"accessTokenExpires\") || 0);",
          "if (!isLogin && !isNoAuth && (!pm.environment.get(\"accessToken\") || Date.now() > expires - 30000)) {",
          "    pm.sendRequest({",
          "        url: pm.environment.get(\"baseUrl\") + \"/v1/auth/token\",",
          "        method: \"POST\",",
          "        header: { \"Content-Type\": \"application/x-www-form-urlencoded\" },",
          "        body: {",
          "            mode: \"urlencoded\",",
          "            urlencoded: [",
          "                { key: \"username\", value: pm.environment.get(\"username\") },",
          "                { key: \"password\", value: pm.environment.get(\"password\") },",
          "            ],",
          "        },",
          "    }, (err, res) => {",
          "        if (!err && res.code === 200) {",
          "            const b = res.json();",
          "            pm.environment.set(\"accessToken\", b.access_token);",
          "            pm.environment.set(\"accessTokenExpires\", String(Date.now() + b.expires_in * 1000));",
          "        } else {",
          "            console.warn(\"Login automático falló\", err || res.code);",
          "        }",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"No filtra mensajes ORA-\", () => pm.expect(pm.response.text()).to.not.include(\"ORA-\"));",
          "pm.test(\"Incluye X-Request-ID\", () => pm.response.to.have.header(\"X-Request-ID\"));",
          "pm.test(\"Header X-Content-Type-Options: nosniff\", () =>",
          "    pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Sin autenticación. Ejecuta SELECT 1 FROM DUAL.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 ok o 503 unavailable\", () => {",
                  "    const b = pm.response.json();",
                  "    if (pm.response.code === 200) pm.expect(b).to.eql({status: \"ok\"});",
                  "    else { pm.expect(pm.response.code).to.eql(503); pm.expect(b).to.eql({status: \"unavailable\"}); }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login (obtener token)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "token"
              ]
            },
            "description": "Guarda el token en el environment (accessToken). Los demás requests lo usan solos.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Devuelve access_token bearer\", () => {",
                  "    pm.expect(b.token_type).to.eql(\"bearer\");",
                  "    pm.expect(b.access_token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(b.expires_in).to.be.above(0);",
                  "});",
                  "pm.environment.set(\"accessToken\", b.access_token);",
                  "pm.environment.set(\"accessTokenExpires\", String(Date.now() + b.expires_in * 1000));"
                ]
              }
            }
          ]
        },
