                  "const code = pm.response.code;",
                  "pm.test(\"200, o 500 genérico si Oracle no está disponible\", () => pm.expect([200, 500]).to.include(code));",
                  "if (code === 200) {",
                  "    const b = pm.response.json();",
                  "    pm.test(\"Formato {page, limit, total, data}\", () =>",
                  "        pm.expect(Object.keys(b).sort()).to.eql([\"data\", \"limit\", \"page\", \"total\"]));",
                  "    pm.test(\"page=1 y limit=20\", () => { pm.expect(b.page).to.eql(1); pm.expect(b.limit).to.eql(20); });",
                  "    pm.test(\"data tiene como máximo 20 registros\", () => pm.expect(b.data.length).to.be.at.most(20));",
                  "} else {",
                  "    pm.test(\"500 sin detalles y con request_id\", () => {",
                  "        const b = pm.response.json();",
                  "        pm.expect(b.detail).to.eql(\"Internal server error\");",
                  "        pm.expect(b.request_id).to.eql(pm.response.headers.get(\"X-Request-ID\"));",
                  "    });",
                  "}"
