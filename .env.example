# Copiar a .env y completar. VALORES FICTICIOS: no usar en ningún entorno real.
# El archivo .env está en .gitignore y nunca debe subirse al repositorio.

# development | test | production  (en production se desactivan /docs, /redoc y /openapi.json)
ENV=development
LOG_LEVEL=INFO

# --- Oracle 11g ---
# jdbc     = driver JDBC de Oracle (ojdbc8) en una JVM embebida. No necesita Instant Client.
# oracledb = python-oracledb en modo thick (con 11g requiere Instant Client 19).
DB_DRIVER=jdbc
# Driver JDBC (descargarlo de Maven Central, ver README) y Java 8+ para ejecutarlo.
JDBC_DRIVER_JAR=lib/ojdbc8-19.27.0.0.jar
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jre-17.x.x-hotspot
DB_USER=api_readonly
DB_PASSWORD=cambiar-por-la-password-real
# Conexión: completar SOLO UNA de las dos.
#   DB_JDBC_URL: jdbc:oracle:thin:@host:puerto:SID  |  @host:puerto/servicio  |  @(DESCRIPTION=...)
#                (sin usuario ni contraseña dentro de la URL)
#   DB_DSN:      formato python-oracledb (host:puerto/servicio o alias de tnsnames)
DB_JDBC_URL=jdbc:oracle:thin:@oracle-host.ejemplo.local:1521:SID
DB_DSN=
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_WAIT_TIMEOUT_MS=3000
DB_CALL_TIMEOUT_MS=5000
# Solo para DB_DRIVER=oracledb: carpeta de Instant Client 19 (vacío = buscar en el PATH)
ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_19_29
# Esquema dueño de las vistas. Vacío si el DBA creó sinónimos para api_readonly.
VIEW_SCHEMA=

# --- Seguridad ---
# Archivo de usuarios de la API (usuario + hash bcrypt). Administrar con:
#   .venv\Scripts\python scripts\manage_users.py add <usuario>
USERS_FILE=users.json
# Secreto para firmar los tokens JWT (mínimo 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si se cambia, todos los tokens emitidos dejan de valer.
JWT_SECRET=REEMPLAZAR-secreto-ficticio-de-al-menos-32-caracteres-0001
# Duración de los tokens, en minutos
JWT_EXPIRE_MINUTES=30
RATE_LIMIT=60/minute
# Límite adicional para POST /v1/auth/token (protección contra fuerza bruta)
LOGIN_RATE_LIMIT=10/minute
# memory:// con un solo proceso; redis://host:6379 si hay varios workers
RATE_LIMIT_STORAGE_URI=memory://
# Orígenes permitidos para CORS, separados por coma. Nunca "*". Vacío = sin CORS.
CORS_ORIGINS=http://localhost:3000
